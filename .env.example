# انسخ هذا الملف باسم .env للتشغيل على جهازك (لا ترفع .env إلى GitHub)

# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# القناة التي ينشر فيها كل البرامج: @اسم_القناة أو -100xxxxxxxxxx (اتركه فارغًا لو تبي كل شيء في محادثتك)
TELEGRAM_CHANNEL_ID=

# معرّف محادثتك الخاصة (رقم): تنبيهات الأعطال + البرامج التي تطابق PERSONAL_TAGS
TELEGRAM_ADMIN_CHAT_ID=

# وسوم التنبيهات الخاصة مفصولة بفواصل؛ * لكل البرامج؛ none لإيقافها
PERSONAL_TAGS=حاسب,لخريجي_الحاسب

# الساعات الهادئة بتوقيت الرياض: نشر بلا إشعار وتأجيل التذكيرات
QUIET_HOURS=23-7

# false | auto | true — استخدام متصفح (Playwright) إذا صارت الصفحة تحتاج JavaScript
RENDER_JS=false

# true = يطبع الرسائل بدل إرسالها ولا يحفظ الحالة
DRY_RUN=false
